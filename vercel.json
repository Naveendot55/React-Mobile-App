{
    "buildCommand": "npm run build",
    "outputDirectory": "docs",
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/docs/assets/$1"
        },
        {
            "src": "/favicon\\.svg",
            "dest": "/docs/favicon.svg"
        },
        {
            "src": "/(.*)\\.(js|css|map|json|png|jpg|jpeg|gif|webp|svg|woff2?|ttf|eot|ico)$",
            "dest": "/docs/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/docs/index.html"
        }
    ]
}