{
    "buildCommand": "npm run build",
    "outputDirectory": "docs",
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/docs/assets/$1",
            "headers": {
                "Content-Type": "application/javascript"
            }
        },
        {
            "src": "/favicon\\.svg",
            "dest": "/docs/favicon.svg"
        },
        {
            "src": "/(.*)\\.(js|css|map|png|jpg|jpeg|gif|webp|svg|woff2?|ttf|eot)",
            "dest": "/docs/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/docs/index.html"
        }
    ]
}